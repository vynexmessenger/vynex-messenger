# Vynex Messenger Backend Environment Configuration
# Copy this file to .env and fill in the values for your PC environment

# Port for the Express server to listen on
PORT=8081

# Public URL of this server (used for returning absolute media URLs to the app)
# e.g. http://localhost:8081 or https://your-ngrok-or-domain.com
BASE_URL=http://localhost:8081

# Local disk storage folder for media uploads
STORAGE_PATH=./storage

# Path to your Firebase service account JSON key file (downloaded from Firebase Console)
# e.g. ./firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Optional: Firebase Project ID (if not reading from service account file)
FIREBASE_PROJECT_ID=
