# ==============================================================================
# Vynex Messenger Backend Environment Configuration Template
# Copy this file to .env and configure for your local environment
# ==============================================================================

# Port for the Express server to listen on
PORT=17012

# Base URL for API access & media downloads
# Use http://localhost:17012 for local PC testing.
# When publicly exposed via tunnel (ngrok / Cloudflare) or cloud deployment,
# update this to the public HTTPS URL (e.g. https://xxxx.ngrok-free.app).
BASE_URL=http://localhost:17012

# Local disk storage folder for media uploads
STORAGE_PATH=./storage

# Path to your Firebase service account JSON key file (downloaded from Firebase Console)
# Place the downloaded JSON file into this folder and specify its relative or absolute path:
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Firebase Project ID (for existing Vynex Firebase project)
FIREBASE_PROJECT_ID=vynex-mess-app
